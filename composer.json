    "keywords": ["roundcube","plugin","autodelete","auto-delete","delete","old messages"],
    "license": "GPL-3.0-or-later",
    "version": "1.1.1",
    "authors": [
        {
            "name": "Ron Crans",
            "email": "ronjc@rjconline.net",
            "role": "Developer"
        }
    ],
    "repositories": [
        {
